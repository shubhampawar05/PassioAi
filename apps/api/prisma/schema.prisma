generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InputType {
  photo
  text
  barcode
  voice
  label
  meal_plan
}

/// A user-confirmed food diary entry. Nutrient columns are nullable: null means
/// the provider did not return that value (never an implied zero).
model FoodLogEntry {
  id                    String    @id @default(uuid()) @db.Uuid
  demoUserId            String    @map("demo_user_id")
  loggedAt              DateTime  @default(now()) @map("logged_at") @db.Timestamptz(3)
  inputType             InputType @map("input_type")
  inputSummary          String    @map("input_summary") @db.VarChar(200)
  foodName              String    @map("food_name") @db.VarChar(200)
  servingUnit           String    @map("serving_unit") @db.VarChar(100)
  servingWeightG        Decimal?  @map("serving_weight_g") @db.Decimal(10, 2)
  servingQuantity       Decimal   @map("serving_quantity") @db.Decimal(10, 3)
  caloriesPerServing    Decimal?  @map("calories_per_serving") @db.Decimal(10, 2)
  proteinGPerServing    Decimal?  @map("protein_g_per_serving") @db.Decimal(10, 2)
  carbohydratesGPerServing Decimal? @map("carbohydrates_g_per_serving") @db.Decimal(10, 2)
  fatGPerServing        Decimal?  @map("fat_g_per_serving") @db.Decimal(10, 2)
  calories              Decimal?  @db.Decimal(10, 1)
  proteinG              Decimal?  @map("protein_g") @db.Decimal(10, 1)
  carbohydratesG        Decimal?  @map("carbohydrates_g") @db.Decimal(10, 1)
  fatG                  Decimal?  @map("fat_g") @db.Decimal(10, 1)
  provider              String    @db.VarChar(20)
  passioRef             String?   @map("passio_ref")
  providerPayload       Json?     @map("provider_payload")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([demoUserId, loggedAt(sort: Desc)])
  @@map("food_log_entries")
}

enum NutritionGoal {
  balanced
  more_protein
  more_fiber
  more_vegetables
  steady_energy
}

/// Demo nutrition profile used as advisor/meal-plan context. Deliberately holds
/// no health data (no age, sex, body measurements, conditions, or medications).
model NutritionProfile {
  id                 String        @id @default(uuid()) @db.Uuid
  demoUserId         String        @unique @map("demo_user_id")
  goal               NutritionGoal @default(balanced)
  dailyCalorieTarget Int?          @map("daily_calorie_target")
  dietPreferences    String[]      @default([]) @map("diet_preferences")
  avoidFoods         String[]      @default([]) @map("avoid_foods")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("nutrition_profiles")
}

enum MealPlanStatus {
  preview
  generating
  ready
  failed
}

/// A Passio-generated meal plan. Raw Passio JSON stays server-side so regenerate,
/// approve, and log requests never trust client-supplied plan data.
model MealPlan {
  id                    String         @id @default(uuid()) @db.Uuid
  demoUserId            String         @map("demo_user_id")
  status                MealPlanStatus @default(preview)
  days                  Int
  notes                 String?        @db.VarChar(300)
  profileSnapshot       Json           @map("profile_snapshot")
  previewPayload        Json           @map("preview_payload")
  planPayload           Json?          @map("plan_payload")
  shoppingListHumanized Json?          @map("shopping_list_humanized")
  errorCode             String?        @map("error_code") @db.VarChar(40)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([demoUserId, createdAt(sort: Desc)])
  @@map("meal_plans")
}
