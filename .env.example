# Copy to .env and fill in. Never commit .env.

# Recognition provider: "passio" (real API, requires PASSIO_API_KEY) or "mock"
# (opt-in development mock; every result is labeled as mock data in the UI).
PASSIO_MODE=passio
# Passio Nutrition AI API key from https://accounts.passiolife.com (server-side only).
PASSIO_API_KEY=
# Optional overrides (defaults shown).
PASSIO_BASE_URL=https://api.passiolife.com/v2
PASSIO_TIMEOUT_MS=45000

# PostgreSQL (docker compose "db" service).
POSTGRES_USER=passio
POSTGRES_PASSWORD=passio_dev_password
POSTGRES_DB=passio_poc
POSTGRES_PORT=5432

# API. Inside docker compose, DATABASE_URL is overridden to use the "db" service name.
DATABASE_URL=postgresql://passio:passio_dev_password@localhost:5432/passio_poc
TEST_DATABASE_URL=postgresql://passio:passio_dev_password@localhost:5432/passio_poc_test
API_PORT=3001
DEMO_USER_ID=demo-user

# Web (published port for the nginx container).
WEB_PORT=8080
